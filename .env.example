# ── Security & App Settings ──────────────────────────────────────────────────
SECRET_KEY=power-solution-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# ── Internationalization ────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# ── Database Configuration ──────────────────────────────────────────────────
# 1. cPanel MySQL / MariaDB (Fill in your cPanel DB credentials):
# MYSQL_DATABASE=yourusername_powersolution
# MYSQL_USER=yourusername_dbuser
# MYSQL_PASSWORD=YourSecurePassword123
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# 2. SQLite (Default fallback if MYSQL_DATABASE is empty):
# DATABASE_URL=sqlite:///db.sqlite3
